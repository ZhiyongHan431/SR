#!/usr/bin/env bash
# Project-local Python packages with the host's matching MetaX GPU runtime.
set -euo pipefail
S5_ENV_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
S5_BUNDLE_ROOT="$(cd -- "${S5_ENV_ROOT}/.." && pwd -P)"
export GRN_S5_ENV_ROOT="${S5_ENV_ROOT}"
export GRN_S5_BACKEND=maca
# Repeatable MACA convolution path; set to 0 only for explicit legacy diagnostics.
export GRN_S5_DETERMINISTIC="${GRN_S5_DETERMINISTIC:-1}"
export CUBLAS_WORKSPACE_CONFIG="${CUBLAS_WORKSPACE_CONFIG:-:4096:8}"
unset PYTHONHOME PYTHONPYCACHEPREFIX
export PYTHONPATH="${S5_ENV_ROOT}/bootstrap:${S5_BUNDLE_ROOT}/scripts"
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
export MACA_PATH="${MACA_PATH:-/opt/maca}"
export MACA_CLANG_PATH="${MACA_PATH}/mxgpu_llvm/bin"
export CUDA_HOME="${MACA_PATH}/tools/cu-bridge"
export CUDA_PATH="${CUDA_HOME}" CUDA_TOOLKIT_ROOT="${CUDA_HOME}"
export LD_LIBRARY_PATH="${S5_ENV_ROOT}/maca/lib/python3.10/site-packages/torch/lib:${S5_ENV_ROOT}/maca_host/usr/lib/x86_64-linux-gnu:${S5_ENV_ROOT}/maca_host/lib/x86_64-linux-gnu:${MACA_PATH}/lib:${MACA_PATH}/mxgpu_llvm/lib:${MACA_PATH}/ompi/lib:${MACA_PATH}/ucx/lib:${CUDA_HOME}/lib64"
export PATH="${S5_ENV_ROOT}/maca/bin:${S5_ENV_ROOT}/bin:${MACA_CLANG_PATH}:${CUDA_HOME}/bin:${MACA_PATH}/bin:/usr/local/bin:/usr/bin:/bin"
export TORCH_HOME="${S5_BUNDLE_ROOT}/protocol/offline_cache/torch"
export HF_HOME="${S5_BUNDLE_ROOT}/protocol/offline_cache/huggingface"
export HF_HUB_CACHE="${HF_HOME}/hub" HUGGINGFACE_HUB_CACHE="${HF_HOME}/hub"
export PYIQA_CACHE_DIR="${S5_BUNDLE_ROOT}/protocol/offline_cache/pyiqa"
export CLIP_CACHE_DIR="${S5_BUNDLE_ROOT}/protocol/offline_cache/clip"
export XDG_CACHE_HOME="${S5_ENV_ROOT}/runtime_cache/maca"
export TRITON_CACHE_DIR="${XDG_CACHE_HOME}/triton"
export TORCH_EXTENSIONS_DIR="${XDG_CACHE_HOME}/torch_extensions"
export CUDA_CACHE_PATH="${XDG_CACHE_HOME}/cuda"
export MPLCONFIGDIR="${XDG_CACHE_HOME}/matplotlib"
export WANDB_DIR="${WANDB_DIR:-${S5_BUNDLE_ROOT}/outputs/wandb}"
mkdir -p "${XDG_CACHE_HOME}/torch/kernels" "${TRITON_CACHE_DIR}" "${TORCH_EXTENSIONS_DIR}" "${CUDA_CACHE_PATH}" "${MPLCONFIGDIR}" "${WANDB_DIR}"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 WANDB_MODE=offline
export PIP_NO_INDEX=1 TOKENIZERS_PARALLELISM=false GRADIO_ANALYTICS_ENABLED=False
export GRN_S5_ALLOW_NETWORK="${GRN_S5_ALLOW_NETWORK:-0}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
exec "${S5_ENV_ROOT}/maca/bin/python" "$@"
